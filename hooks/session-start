#!/usr/bin/env bash
set -euo pipefail

escape_for_json() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '%s' "$value"
}

session_context=$(cat <<'EOF'
<NEXUS>
Nexus is available for code and repository work. Precedence is: system and managed policy; explicit user instructions; host-native safety and approval controls; project instructions; Nexus; optional plugins.

For a code or repository change, invoke `$using-nexus` before editing. Do not load Nexus workflow skills for general conversation, research, or read-only questions.

Never create a worktree, commit, merge, or push without explicit approval. Prefer existing tests; if a new test is the relevant missing sensor, propose its scope and ask approval. Without approval or another suitable check, report Uncertain. For long work, keep a concise task capsule with the goal, decisions, affected area, validation, and next step; do not persist it unless the user asks.
</NEXUS>
EOF
)
escaped=$(escape_for_json "$session_context")

# Cursor sets CURSOR_PLUGIN_ROOT (and may also set CLAUDE_PLUGIN_ROOT).
# Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI.
# Copilot CLI and unknown hosts use top-level additionalContext.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$escaped"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$escaped"
fi
